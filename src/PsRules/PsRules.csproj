<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PsRules</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the label tables travel in the DLL: AppImage/portable packaging stays untouched.
         Two files because provenance differs: labels-zh.json is copied verbatim from the client's own
         name tables, labels-zh-named.json is our translation of what those tables do not cover. -->
    <EmbeddedResource Include="Labels/labels-zh.json" />
    <EmbeddedResource Include="Labels/labels-zh-named.json" />
    <!-- Folder-level names for the ground-effect tree: keyed by path prefix, official 繁體 only. -->
    <EmbeddedResource Include="Labels/ground-effects-zh.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="pstests" />
  </ItemGroup>

</Project>