<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- 版本号唯一来源是 git tag:发布时由 CI 传 -p:Version=1.1.0(tag v1.1,去掉前导 v)。
         没有 tag 的本地构建拿到 0.0.0-dev,不再谎报 1.0.0。
         这里刻意**不写** AssemblyVersion / FileVersion:SDK 会从 Version 派生数字版本
         (1.1.0 -> 1.1.0.0),写死反而会让 -p:Version 覆盖不掉它们。 -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <!-- 先按 RID 选原生库目录,再按宿主 OS 兜底。只按宿主判断会在交叉发布时出错:
         在 Linux 上 publish -r win-x64 会挑到 linux-x64 的 DLL。 -->
    <LibGGPK3Dir Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">$(MSBuildThisFileDirectory)vendor/libggpk3/win-x64</LibGGPK3Dir>
    <LibGGPK3Dir Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))">$(MSBuildThisFileDirectory)vendor/libggpk3/linux-x64</LibGGPK3Dir>
    <LibGGPK3Dir Condition="'$(LibGGPK3Dir)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">$(MSBuildThisFileDirectory)vendor/libggpk3/linux-x64</LibGGPK3Dir>
    <LibGGPK3Dir Condition="'$(LibGGPK3Dir)' == ''">$(MSBuildThisFileDirectory)vendor/libggpk3/win-x64</LibGGPK3Dir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="LibBundle3" Condition="Exists('$(LibGGPK3Dir)/LibBundle3.dll')">
      <HintPath>$(LibGGPK3Dir)/LibBundle3.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="LibGGPK3" Condition="Exists('$(LibGGPK3Dir)/LibGGPK3.dll')">
      <HintPath>$(LibGGPK3Dir)/LibGGPK3.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="LibBundledGGPK3" Condition="Exists('$(LibGGPK3Dir)/LibBundledGGPK3.dll')">
      <HintPath>$(LibGGPK3Dir)/LibBundledGGPK3.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SystemExtensions" Condition="Exists('$(LibGGPK3Dir)/SystemExtensions.dll')">
      <HintPath>$(LibGGPK3Dir)/SystemExtensions.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(OutputType)' == 'Exe'">
    <None Include="$(LibGGPK3Dir)/liboo2core.so"
          Condition="Exists('$(LibGGPK3Dir)/liboo2core.so')"
          Link="liboo2core.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(LibGGPK3Dir)/oo2core.dll"
          Condition="Exists('$(LibGGPK3Dir)/oo2core.dll')"
          Link="oo2core.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>