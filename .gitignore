# Build output
**/bin/
**/obj/
build/
dist/

# Test scratch
.test/
.test-all/
gui.png

# Large local analysis / tooling downloads
# vendor/* (not vendor/): git cannot re-include a file once its parent
# directory is excluded, so the whitelist below needs the directory left open.
vendor/*

doc-bk/

# Keep only the LibGGPK3 assemblies/native libraries required by the build
# (drops linux-x64.zip / win-x64.zip and every other vendored payload)
!vendor/libggpk3/
vendor/libggpk3/*
!vendor/libggpk3/linux-x64/
!vendor/libggpk3/win-x64/

vendor/libggpk3/linux-x64/*
!vendor/libggpk3/linux-x64/LibBundle3.dll
!vendor/libggpk3/linux-x64/LibGGPK3.dll
!vendor/libggpk3/linux-x64/LibBundledGGPK3.dll
!vendor/libggpk3/linux-x64/SystemExtensions.dll
!vendor/libggpk3/linux-x64/liboo2core.so

vendor/libggpk3/win-x64/*
!vendor/libggpk3/win-x64/LibBundle3.dll
!vendor/libggpk3/win-x64/LibGGPK3.dll
!vendor/libggpk3/win-x64/LibBundledGGPK3.dll
!vendor/libggpk3/win-x64/SystemExtensions.dll
!vendor/libggpk3/win-x64/oo2core.dll

# Keep the AppImage packer and the runtime it embeds: scripts/build-appimage.sh
# falls back to vendor/appimage/appimagetool-x86_64.AppImage when appimagetool is
# not on PATH, so a fresh clone must be able to build the AppImage without a
# manual download. Nothing else in this directory is needed.
!vendor/appimage/
vendor/appimage/*
!vendor/appimage/appimagetool-x86_64.AppImage
!vendor/appimage/runtime-x86_64

# IDE
.vs/
.vscode/
*.user
